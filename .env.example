# =====================================================================
# 3T DAIRY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your values
# =====================================================================

# Supabase Database & Auth (Optional Cloud Sync)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Enterprise Session Authentication
SESSION_SECRET=your_32_character_random_secret_here
ADMIN_PASSWORD=your_secure_admin_password
BRANCH_PASSWORD=your_secure_branch_password

# Razorpay Payment Gateway (Instant Payouts)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Gemini AI — AI Mitra Multilingual Assistant
# Obtain key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

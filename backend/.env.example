# 3T Backend - Environment Variables Configuration Template
PORT=5000
MONGODB_URI=mongodb://localhost:27017/threet

# Payout Gateway Credentials (e.g. RazorpayX / Cashfree)
PAYOUT_API_KEY=your_payout_api_key_here
PAYOUT_SECRET=your_payout_secret_here
PAYOUT_ACCOUNT_NUMBER=your_merchant_account_number

# Webhook Secret for HMAC Signature Verification
WEBHOOK_SECRET=your_gateway_webhook_secret_here
